# Base URL of the Restaurant Scraper API, without a trailing slash.
#
# Local development, with `uvicorn app.main:app --reload` running in the API repo:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#
# Production: point this at the deployed backend, e.g.
#   NEXT_PUBLIC_API_URL=https://YOUR-ACTUAL-SERVICE.onrender.com
#
# Whatever origin this app is served from must also appear in the API's CORS_ORIGINS, or the
# browser will block every request before it reaches the server.
