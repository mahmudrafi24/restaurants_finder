{
  "name": "restaurant-scraper-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web interface for searching and exporting OpenStreetMap cafe, restaurant and fast-food data by city.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
